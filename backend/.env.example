# ===== Application =====
APP_NAME=AI Resume Screening & Job Matching API
APP_VERSION=1.0.0
DEBUG=True
API_V1_PREFIX=/api/v1

# CORS (comma separated origins)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== Database =====
# Local PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:Megha%2312@localhost:5432/resume_screening
# Docker Compose uses the db service instead:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/resume_screening

# ===== Security =====
SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Uploads =====
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=.pdf,.docx

# ===== AI =====
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm

# Matching weights (must add up to 1.0)
WEIGHT_SKILLS=0.45
WEIGHT_SEMANTIC=0.30
WEIGHT_EXPERIENCE=0.15
WEIGHT_EDUCATION=0.10

# ===== Optional LLM (leave LLM_API_KEY empty to run fully offline) =====
# When a key is set, resume parsing and matching use an LLM for much more
# accurate summary/education/experience extraction and job-fit scoring.
# Providers: groq | openrouter | openai | gemini
LLM_PROVIDER=groq
LLM_API_KEY=
# Optional overrides (empty = provider default below):
#   groq:      model + base built in
#   openrouter:  meta-llama/llama-3.3-70b-instruct @ https://openrouter.ai/api/v1
#   openai:    gpt-4o-mini @ https://api.openai.com/v1
#   gemini:    gemini-1.5-flash @ https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=90
USE_LLM_MATCHING=True

# ===== Seed data =====
SEED_ADMIN_EMAIL=admin@demo.com
SEED_ADMIN_PASSWORD=admin1234
