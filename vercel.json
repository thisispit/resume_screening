{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "backend:/api/$1" },
    { "source": "/health",   "destination": "backend:/health" },
    { "source": "/(.*)",     "destination": "frontend:/$1" }
  ]
}
